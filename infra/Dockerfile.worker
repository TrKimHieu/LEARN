# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/compute/package.json apps/compute/package.json
# Web và mobile chỉ cần manifest để npm ci đọc được lockfile chung; không cài dependency của chúng.
COPY apps/web/package.json apps/web/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/ai/package.json packages/ai/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/db/prisma packages/db/prisma
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund --include-workspace-root \n  -w apps/api -w apps/worker -w apps/compute -w packages/ai -w packages/config -w packages/contracts -w packages/db
COPY . .
RUN npm run db:generate
RUN npm run build -w apps/worker
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/apps/api/package.json apps/api/package.json
COPY --from=builder /app/apps/worker/package.json apps/worker/package.json
COPY --from=builder /app/apps/compute/package.json apps/compute/package.json
COPY --from=builder /app/apps/web/package.json apps/web/package.json
COPY --from=builder /app/apps/mobile/package.json apps/mobile/package.json
COPY --from=builder /app/packages/ai/package.json packages/ai/package.json
COPY --from=builder /app/packages/config/package.json packages/config/package.json
COPY --from=builder /app/packages/contracts/package.json packages/contracts/package.json
COPY --from=builder /app/packages/db/package.json packages/db/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts --no-audit --no-fund -w apps/worker
COPY --from=builder /app/packages/db/generated packages/db/generated
COPY --from=builder /app/apps/worker/dist apps/worker/dist
USER node
CMD ["node", "apps/worker/dist/main.js"]
