# syntax=docker/dockerfile:1
# Build từ root repo: docker build -f infra/Dockerfile.web .
# Bỏ qua file theo infra/Dockerfile.web.dockerignore (BuildKit), không theo .dockerignore ở root.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
# Manifest mọi workspace để npm ci đọc được lockfile chung; chỉ cài dependency của web.
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/compute/package.json apps/compute/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY packages/ai/package.json packages/ai/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/contracts packages/contracts
COPY apps/web/package.json apps/web/package.json
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --no-audit --no-fund -w apps/web
COPY apps/web apps/web
# Empty (default) = relative /api paths behind a same-origin reverse proxy (ADR 017).
# Set an absolute API origin only when web and API are served from different origins.
ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build -w apps/web
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
# Trong monorepo, `output: 'standalone'` đặt server ở apps/web/ bên trong standalone.
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static apps/web/.next/static
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
